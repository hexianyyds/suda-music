# 默认按文本处理，入库统一用 LF
* text=auto eol=lf

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 脚本必须是 LF，否则在 Linux 上无法执行（exit code 126）
gradlew text eol=lf
*.sh text eol=lf

# 二进制文件不做任何转换
*.jar binary
*.aar binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.so binary
